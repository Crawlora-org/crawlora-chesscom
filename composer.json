    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "chesscom",
    "chess-com",
    "chesscom-api",
    "chess-com-api",
    "chesscom-scraper",
    "chess-com-scraper",
    "chesscom-data",
    "chess-com-data",
    "chesscom-puzzles",
    "chesscom-player-club-resources",
    "chesscom-tournaments",
    "chesscom-public-team-matches"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
