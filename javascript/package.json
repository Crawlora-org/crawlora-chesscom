{
  "name": "@crawlora-org/chesscom",
  "version": "0.1.1",
  "description": "Crawlora Chess.com API client with 26 endpoints for puzzles, player and club resources, tournaments, and public team matches",
  "homepage": "https://crawlora.net/?utm_source=npm&utm_medium=referral&utm_campaign=platform-clients&utm_content=chesscom-javascript-homepage",
  "bugs": { "url": "https://github.com/Crawlora-org/crawlora-chesscom/issues" },
  "keywords": ["crawlora", "api-client", "sdk", "web-scraping", "scraping-api", "chesscom", "chess-com", "chesscom-api", "chess-com-api", "chesscom-scraper", "chess-com-scraper", "chesscom-data", "chess-com-data", "chesscom-puzzles", "chesscom-player-club-resources", "chesscom-tournaments", "chesscom-public-team-matches"],
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": ["src", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Crawlora-org/crawlora-chesscom",
    "directory": "javascript"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run --ignore-scripts",
    "generate": "python3 ../scripts/generate.py"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
